<Window x:Class="CyberSafeBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✨ Cyber Princess Bot ✨" Height="650" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#FFf9e6f0">
    <!-- soft pink -->
    <Window.Resources>
        <!-- Round corner style for chat bubbles -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#FFD8BFD8"/>
            <!-- lavender -->
            <Setter Property="Margin" Value="10,5,50,5"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="BotBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#FFFFB6C1"/>
            <!-- light pink -->
            <Setter Property="Margin" Value="50,5,10,5"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII Art with cute colors -->
        <Border Grid.Row="0" Background="#FFE6E6FA" CornerRadius="15" Margin="0,0,0,10" Padding="10">
            <TextBlock x:Name="txtAscii" FontFamily="Consolas" FontSize="10" Foreground="#FF8B008B"
                        FontWeight="Bold" Background="#FFF0F0FF"
                        TextAlignment="Center" TextWrapping="Wrap" Margin="5"/>
                      
        </Border>
        
        

        <!-- Chat area: ScrollViewer with StackPanel (required) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#FFFDF5E6">
            <StackPanel x:Name="chatStackPanel" Orientation="Vertical" Margin="5"/>
        </ScrollViewer>

        <!-- Input area -->
        <Border Grid.Row="2" Background="#FFFFE4E1" CornerRadius="15" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtUserInput" Grid.Column="0" Height="40" FontSize="14"
                         Background="White" Foreground="#FF4B0082"
                         BorderBrush="#FFDDA0DD" BorderThickness="2"
                         KeyDown="TxtUserInput_KeyDown"
                         FontFamily="Segoe UI" VerticalContentAlignment="Center"/>
                <Button x:Name="btnSend" Grid.Column="1" Width="80" Height="40" Content="💬 Send"
                        Margin="8,0,0,0" Click="BtnSend_Click"
                        Background="#FFDA70D6" Foreground="White" FontWeight="Bold"
                        BorderBrush="#FFBA55D3" BorderThickness="1" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
    </Window>