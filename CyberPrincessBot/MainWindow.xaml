<Window x:Class="CyberSafeBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✨ Cyber Safe Bot ✨" Height="750" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FFF9F0FF"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Style for user messages (right side) -->
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#FFD8BFD8"/>
            <!-- Light purple -->
            <Setter Property="Margin" Value="10,5,50,5"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <!-- Style for bot messages (left side) -->
        <Style x:Key="BotBubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#FFFFB6C1"/>
            <!-- Light pink -->
            <Setter Property="Margin" Value="50,5,10,5"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Chat Area -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ASCII Art -->
            <Border Grid.Row="0" Background="#FFE6E6FA" CornerRadius="15" Margin="0,0,10,10" Padding="10">
                <TextBlock x:Name="txtAscii" FontFamily="Consolas" FontSize="10" Foreground="#FFDB7099"
                           TextAlignment="Center" TextWrapping="Wrap" FontWeight="Bold"/>
            </Border>

            <!-- Chat Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#FFFDF5E6" Margin="0,0,10,10">
                <StackPanel x:Name="chatStackPanel" Orientation="Vertical" Margin="5"/>
            </ScrollViewer>

            <!-- Input Area -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,10,0">
                <Button x:Name="btnQuiz" Content="🎮 Quiz" Width="70" Height="35" 
                        Background="#FFBA55D3" Foreground="White" FontWeight="Bold" Click="BtnQuiz_Click"
                        Margin="0,0,5,0"/>
                <Button x:Name="btnLog" Content="📊 Log" Width="70" Height="35" 
                        Background="#FF9370DB" Foreground="White" FontWeight="Bold" Click="BtnLog_Click"
                        Margin="0,0,5,0"/>
                <Button x:Name="btnTasks" Content="📋 Tasks" Width="70" Height="35" 
                        Background="#FF8A2BE2" Foreground="White" FontWeight="Bold" Click="BtnTasks_Click"
                        Margin="0,0,5,0"/>
                <TextBox x:Name="txtUserInput" Width="200" Height="35" FontSize="14" 
                         Background="LightYellow" KeyDown="TxtUserInput_KeyDown"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="btnSend" Content="💬 Send" Width="70" Height="35" 
                        Background="#FFDA70D6" Foreground="White" FontWeight="Bold" Click="BtnSend_Click"
                        Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT COLUMN: Task Panel -->
        <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Background="#FFF0F0FF" 
                CornerRadius="15" Padding="10" Margin="10,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📋 Task Assistant" FontSize="18" FontWeight="Bold" 
                           Foreground="#FF6A0DAD" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <Label Grid.Row="1" Content="Task Title:" Foreground="#FF4B0082"/>
                <TextBox x:Name="txtTaskTitle" Grid.Row="2" Height="30" Margin="0,0,0,10"/>

                <Label Grid.Row="3" Content="Reminder (optional):" Foreground="#FF4B0082"/>
                <TextBox x:Name="txtReminder" Grid.Row="4" Height="30" Margin="0,0,0,10" 
                         Text="e.g., remind me in 3 days"/>

                <Button x:Name="btnAddTask" Grid.Row="5" Content="➕ Add Task" Height="35" 
                        Background="#FFBA55D3" Foreground="White" FontWeight="Bold" 
                        Click="BtnAddTask_Click" Margin="0,0,0,10"/>

                <ListBox x:Name="lstTasks" Grid.Row="6" Height="120" Margin="0,0,0,5"
                         DisplayMemberPath="Title" SelectionChanged="LstTasks_SelectionChanged"/>

                <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnComplete" Content="✅ Complete" Width="80" Height="30" 
                            Background="#FF66BB6A" Foreground="White" FontWeight="Bold" 
                            Click="BtnComplete_Click" Margin="0,0,5,0"/>
                    <Button x:Name="btnDelete" Content="🗑️ Delete" Width="80" Height="30" 
                            Background="#FFEF5350" Foreground="White" FontWeight="Bold" 
                            Click="BtnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>