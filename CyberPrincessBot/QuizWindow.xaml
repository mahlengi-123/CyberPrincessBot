<Window x:Class="CyberSafeBot.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎮 Cyber Chat" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F0FF" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF6A0DAD" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <TextBlock Text="🛡️ Cyber Chat" FontSize="22" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Subtitle -->
        <TextBlock Grid.Row="1" Text="Cybersecurity Awareness Bot" FontSize="14" 
                   Foreground="#FF6A0DAD" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Score & Progress -->
        <Border Grid.Row="2" Background="#FFF0EAFF" CornerRadius="8" Padding="10" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="txtProgress" Text="Question 1 of 12" FontSize="14" 
                           Foreground="#FF4B0082" FontWeight="Bold" Margin="0,0,15,0"/>
                <TextBlock x:Name="txtScore" Text="Score: 0" FontSize="14" 
                           Foreground="#FF6A0DAD" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Question -->
        <Border Grid.Row="3" Background="#FFF8F0FF" CornerRadius="10" Padding="15" Margin="0,0,0,15"
                BorderBrush="#FFE0D0F0" BorderThickness="1">
            <TextBlock x:Name="txtQuestion" Text="Question text here" 
                       FontSize="16" Foreground="#FF4B0082" TextWrapping="Wrap"/>
        </Border>

        <!-- Options (RadioButtons) - FIXED -->
        <ItemsControl x:Name="optionsList" Grid.Row="4" Margin="0,0,0,15">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Wrap RadioButton in a Border for rounded corners -->
                    <Border CornerRadius="5" Background="#FFF8F0FF" 
                            BorderBrush="#FFD0C0E0" BorderThickness="1" 
                            Padding="2" Margin="0,2">
                        <RadioButton Content="{Binding}" GroupName="Options" 
                                     FontSize="14" Foreground="#FF333333" 
                                     Cursor="Hand" Padding="8,3"
                                     HorizontalAlignment="Left" Width="440"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="btnSubmit" Content="✅ Submit Answer" Width="140" Height="35" 
                    Background="#FFBA55D3" Foreground="White" FontWeight="Bold" 
                    Click="BtnSubmit_Click" Margin="0,0,10,0" FontSize="13"/>
            <Button x:Name="btnNext" Content="➡️ Next Question" Width="140" Height="35" 
                    Background="#FF9370DB" Foreground="White" FontWeight="Bold" 
                    Click="BtnNext_Click" IsEnabled="False" FontSize="13"/>
        </StackPanel>

        <!-- Feedback -->
        <TextBlock x:Name="txtFeedback" Grid.Row="6" Text="" FontSize="13" 
                   Foreground="#FF333333" TextWrapping="Wrap" Margin="0,5,0,0"
                   HorizontalAlignment="Center" FontWeight="Bold"/>
    </Grid>
</Window>